+package jp.personal.n2memory;
+
+import java.util.*;
+
+/** Stable links for the owner's private GitHub Release listening archives. */
+final class ListeningReleaseCatalog {
+    private static final String REPOSITORY="https://github.com/fabiohan580-art/N2Memory-Android";
+    private static final Set<String> LEVELS=new HashSet<>(Arrays.asList("N1","N2","N3"));
+
+    private ListeningReleaseCatalog(){}
+
+    static boolean supportsLevel(String level){return LEVELS.contains(normalizeLevel(level));}
+
+    static String normalizeLevel(String level){return level==null?"":level.trim().toUpperCase(Locale.ROOT);}
+
+    static String releaseTag(String level){
+        String normalized=normalizeLevel(level);
+        if(!supportsLevel(normalized))throw new IllegalArgumentException("当前只提供N1、N2、N3真题听力");
+        if("N1".equals(normalized))return "listening-n1-v1";
+        if("N2".equals(normalized))return "listening-n2-v1";
+        return "listening-n3-v1";
+    }
+
+    static String releaseUrl(String level){return REPOSITORY+"/releases/tag/"+releaseTag(level);}
+
+    static List<String> sessions(String level){
+        String normalized=normalizeLevel(level);
+        if(!supportsLevel(normalized))return Collections.emptyList();
+        ArrayList<String> result=new ArrayList<>();
+        for(int year=2010;year<=2025;year++){
+            if(year!=2020)result.add(String.format(Locale.ROOT,"%04d-07",year));
+            // The N3 release currently has no 2010-12 archive.
+            if(!(year==2010&&"N3".equals(normalized)))result.add(String.format(Locale.ROOT,"%04d-12",year));
+        }
+        Collections.reverse(result);
+        return result;
+    }
+
+    static String examId(String level,String session){return session+"_"+normalizeLevel(level);}
+
+    static String assetName(String level,String session){
+        String exam=examId(level,session);
+        // Preserve the actual uploaded asset name while importing it as 2025-07_N3.
+        return "N3".equals(normalizeLevel(level))&&"2025-07".equals(session)?exam+"_vietnam.zip":exam+".zip";
+    }
+
+    static String assetUrl(String level,String session){return REPOSITORY+"/releases/download/"+releaseTag(level)+"/"+assetName(level,session);}
+
+    static String levelFromExam(String examId){
+        if(examId==null)return "";
+        int split=examId.lastIndexOf('_');
+        return split<0?"":normalizeLevel(examId.substring(split+1));
+    }
+
+    static String sessionFromExam(String examId){
+        if(examId==null)return "";
+        int split=examId.lastIndexOf('_');
+        return split<0?"":examId.substring(0,split);
+    }
+
+    static boolean supportsExam(String examId){
+        String level=levelFromExam(examId),session=sessionFromExam(examId);
+        return supportsLevel(level)&&sessions(level).contains(session);
+    }
+}
