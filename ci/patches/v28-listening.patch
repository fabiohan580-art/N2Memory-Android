+package jp.personal.n2memory;
+
+public final class ListeningReleaseCatalogTest {
+    public static void main(String[] args){
+        check(ListeningReleaseCatalog.sessions("N1").size()==31,"N1 archive count");
+        check(ListeningReleaseCatalog.sessions("N2").size()==31,"N2 archive count");
+        check(ListeningReleaseCatalog.sessions("N3").size()==30,"N3 archive count");
+        check(!ListeningReleaseCatalog.sessions("N2").contains("2020-07"),"cancelled 2020-07 excluded");
+        check(!ListeningReleaseCatalog.sessions("N3").contains("2010-12"),"missing N3 archive excluded");
+        check("2025-07_N3_vietnam.zip".equals(ListeningReleaseCatalog.assetName("n3","2025-07")),"uploaded N3 alias");
+        check(ListeningReleaseCatalog.assetUrl("N2","2024-07").endsWith("/listening-n2-v1/2024-07_N2.zip"),"N2 asset URL");
+        check(ListeningReleaseCatalog.supportsExam("2024-12_N1"),"supported exam");
+        check(!ListeningReleaseCatalog.supportsExam("2020-07_N1"),"cancelled exam not offered");
+        System.out.println("ListeningReleaseCatalogTest OK");
+    }
+    private static void check(boolean value,String label){if(!value)throw new AssertionError(label);}
+}
