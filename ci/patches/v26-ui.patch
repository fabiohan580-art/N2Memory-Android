+from pathlib import Path
+
+root = Path(__file__).resolve().parents[1]
+main = (root / "app/src/main/java/jp/personal/n2memory/MainActivity.java").read_text(encoding="utf-8")
+speech = (root / "app/src/main/java/jp/personal/n2memory/SpeechController.java").read_text(encoding="utf-8")
+cloud = (root / "app/src/main/java/jp/personal/n2memory/CloudVoiceClient.java").read_text(encoding="utf-8")
+repo = (root / "app/src/main/java/jp/personal/n2memory/OfflineMasterRepository.java").read_text(encoding="utf-8")
+gradle = (root / "app/build.gradle").read_text(encoding="utf-8")
+
+assert "versionCode 26" in gradle
+assert "versionName '0.26.0'" in gradle
+assert "V26 正在载入学习列表" in main
+
+# Direct source-question detail and generated practice both advance after submit.
+for marker in ["提交答案并自动下一题", "adjacentStructuredExam(q,level,term,page,1,true)",
+               "提交本题并自动下一题", "customIndex++;customPracticeQuestion()"]:
+    assert marker in main, marker
+for marker in ["button(\"上一题\"", "button(\"下一题\"", "返回题目列表", "返回训练中心"]:
+    assert marker in main, marker
+assert "JSONObject adjacentQuestion" in repo
+
+# Default cloud voice is an adult voice, selectable, and cache identity includes speaker.
+for marker in ["DEFAULT_SPEAKER=13", "VOICEVOX:青山龍星", "voicevox:\"+speaker+\":v2"]:
+    assert marker in cloud, marker
+for marker in ["selectCloudSpeaker", "cloud_voice_speaker", "联网成人音色"]:
+    assert marker in speech + main, marker
+
+print({"version": 26, "auto_next": True, "previous_and_return": True,
+       "adult_cloud_voice": True, "selectable_cloud_voice": True})
