+import json
+from pathlib import Path
+
+root = Path(__file__).resolve().parents[1]
+main = (root / "app/src/main/java/jp/personal/n2memory/MainActivity.java").read_text(encoding="utf-8")
+speech = (root / "app/src/main/java/jp/personal/n2memory/SpeechController.java").read_text(encoding="utf-8")
+vocab = json.loads((root / "app/src/main/assets/vocabulary.json").read_text(encoding="utf-8"))
+keigo = json.loads((root / "app/src/main/assets/keigo_samples.json").read_text(encoding="utf-8"))
+kanji = json.loads((root / "app/src/main/assets/kanji.json").read_text(encoding="utf-8"))
+
+core = [x for x in vocab if x.get("corePriority")]
+verbs = [x for x in core if "动词" in x.get("studyCategories", [])]
+assert len(core) == 6006
+assert len(verbs) >= 2000
+assert len(keigo) >= 50
+assert len(kanji) == 3500
+assert "showCoreVocabularyInline(w)" in main
+assert "默认OKJLPT 6006主词库" in main
+assert "表外读音默认隐藏" in main
+assert "常用词、例句与中文意思" in main
+assert 'new String[]{"文字・語彙","文法","読解","聴解"}' in main
+assert "examSourcePosition(q,questions,index)" in main
+assert "OKJLPT主词库2000+动词" in main
+assert "商务固定表达" in main
+assert 'if(!"offline".equals(mode())){cloudSpeech(text,true);return;}' in speech
+assert "联网发音暂不可用，已切换本机日语语音" in speech
+print({"version": 27, "core_vocab": len(core), "core_verbs": len(verbs), "keigo": len(keigo), "kanji": len(kanji)})
